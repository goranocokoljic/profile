{
  "name": "profile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/export-build-data.mjs",
    "build": "astro build",
    "build:meta": "node scripts/export-build-data.mjs --write-meta",
    "readme:runs": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/readme-run-table.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit && eslint . && stylelint \"src/**/*.scss\" && npm run test:unit && npm run test:data",
    "test": "playwright test",
    "test:baselines:linux": "node scripts/linux-baselines.mjs",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:data": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/export-build-data.test.mjs scripts/externalize-inline.test.mjs scripts/record-run.test.mjs scripts/readme-run-table.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "astro": "^5.18.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "sass": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3"
  }
}
