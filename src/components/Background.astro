---
import { site } from '../data/site';

const { background, markup } = site;
---

<section class="background-section" id="about" aria-labelledby="about-title">
  <div class="container background-grid">
    <div class="background-copy">
      <p class="eyebrow">{background.eyebrow}</p>
      <h2 class="section-title" id="about-title">{background.title}</h2>
      <div class="background-paragraphs">
        {background.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="cv-line">
        <span>{background.cv}</span>
        <a href={markup.cvHref}>{markup.backgroundCvLink}</a>
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;

  .background-section {
    padding: $space-3xl 0;
    background: #fbfbf9;
    border-bottom: 1px solid var(--fine);
  }

  // Single column, at most 820px wide (the reference's v3 override).
  .background-grid {
    max-width: 820px;
  }

  .background-paragraphs p {
    color: var(--muted);
    line-height: 1.6;
  }

  .cv-line a {
    color: var(--teal);
    font-weight: 650;

    &:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }
</style>
