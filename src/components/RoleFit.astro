---
import { site } from '../data/site';

const { roleFit } = site;
// Two-digit ordinal from the item's position, as the reference renders it.
const ordinal = (i: number): string => String(i + 1).padStart(2, '0');
---

<section class="role-fit container" aria-labelledby="role-fit-title">
  <span class="section-kicker" aria-hidden="true"></span>
  <h2 id="role-fit-title">{roleFit.title}</h2>
  <p class="role-intro">{roleFit.intro}</p>
  <div class="role-grid">
    {
      roleFit.items.map((item, i) => (
        <article class="role-item">
          <span class="role-index">{ordinal(i)}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;

  .role-fit {
    padding: $space-2xl 0 72px;
    border-bottom: 1px solid var(--fine);
  }

  .section-kicker {
    display: block;
    width: 38px;
    height: 2px;
    background: var(--teal);
    margin-bottom: 26px;
  }

  h2 {
    font-size: clamp(40px, 4vw, 60px);
    line-height: 1;
    letter-spacing: -0.045em;
    margin: 0;
    max-width: 820px;
  }

  .role-intro {
    max-width: 980px;
    font-size: $type-lead;
    line-height: 1.55;
    color: #444b53;
    margin: 26px 0 54px;
  }

  .role-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 42px 68px;
  }

  .role-item {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: $space-sm;

    h3 {
      margin: 0 0 $space-2xs;
      font-size: 18px;
    }

    p {
      margin: 0;
      color: var(--muted);
      line-height: 1.48;
      max-width: 500px;
    }
  }

  .role-index {
    font-family: var(--mono);
    color: var(--teal-text);
    font-size: $type-label;
    padding-top: 4px;
  }

  @media (max-width: $bp-tablet) {
    .role-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  @media (max-width: $bp-phone) {
    .role-fit {
      padding-top: 60px;
    }

    .role-intro {
      font-size: $type-body;
    }
  }
</style>
